# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored — never commit it.

# Paste your MRHSession cookie value here to authenticate through the
# ITER BIG-IP perimeter when running the dashboard locally (npm run dev).
#
# Easier: use the keyring instead — run:  ./scripts/dev-auth.sh --store
# Then start dev server with:             npm run dev:auth
#
# How to get the cookie value:
#   1. Open https://simdb.iter.org in your browser and log in
#   2. DevTools (F12) → Application → Cookies → simdb.iter.org
#   3. Copy the value of the "MRHSession" cookie
#
VITE_MRH_SESSION=paste_your_MRHSession_cookie_value_here
