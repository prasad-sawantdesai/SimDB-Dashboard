# save this template as /etc/nginx/templates/*.template and
# envsubst will substitute ${SOMETHING} from environment at nginx startup


server {
    listen 8080;
    # listen [::]:8080;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;

    location = / {
        return 302 /dashboard/;
    }
    location = /dashboard {
        return 302 /dashboard/;
    }
    location /dashboard/ {
        try_files $uri $uri/ /dashboard/index.html;
    }
    location = /scenarios/api {
        return 301 /scenarios/api/;
    }
    location /scenarios/api/ {
        # Match the production public route:
        # /scenarios/api/v1.2/... -> http://API_HOST:API_PORT/v1.2/...
        include proxy_params;
        proxy_pass http://${API_HOST}:${API_PORT}/;
    }
    location /api/ {
        # Local/dev compatibility alias:
        # /api/v1.2/... -> http://API_HOST:API_PORT/v1.2/...
        include proxy_params;
        proxy_pass http://${API_HOST}:${API_PORT}/;
    }
    # maps /v1.2 -> :5000/v1.2 etc
    # note w/o trailing slash (don't remove /v1.2)
    location /v1/ { include proxy_params; proxy_pass http://${API_HOST}:${API_PORT}; }
    location /v1.1/ { include proxy_params; proxy_pass http://${API_HOST}:${API_PORT}; }
    location /v1.2/ { include proxy_params; proxy_pass http://${API_HOST}:${API_PORT}; }
    location /swaggerui/ { include proxy_params; proxy_pass http://${API_HOST}:${API_PORT}; }

    location = /dashboard/runtime-config.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files /runtime-config-template.js =404;
        sub_filter_once off;
        sub_filter_types application/javascript;
        # Inject the browser-facing SimDB endpoint at container startup. The
        # default matches production (/scenarios/api), so test deployments can
        # use the same public route shape as production.
        sub_filter 'SIMDB_SERVER_URL' '${PUBLIC_SIMDB_URL}';
    }
}
